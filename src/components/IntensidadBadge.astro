---
// src/components/IntensidadBadge.astro
// diseno-visual-fiestajuegos.md §7.1
import Icon from "./Icon.astro";

interface Props {
  niveles: string[]; // ej. ["suave", "normal"] — los disponibles para este juego
  escala?: boolean; // true = juego tipo Preguntas Escalonadas (progresión automática)
  interactivo?: boolean; // true = los botones actualizan ?intensidad= en la URL
  activo?: string; // nivel actualmente seleccionado, si interactivo
}

const { niveles, escala = false, interactivo = false, activo = "normal" } = Astro.props;

const ORDEN = ["suave", "normal", "picante"] as const;
const COLOR_CLASE: Record<string, string> = {
  suave: "text-suave",
  normal: "text-normal",
  picante: "text-picante",
};
const ETIQUETA: Record<string, string> = { suave: "Suave", normal: "Normal", picante: "Picante" };
---

{escala ? (
  <span class="inline-flex items-center gap-1.5 text-secundario font-medium">
    <Icon name="trending-up" size={18} />
    Escala
  </span>
) : (
  <div class="inline-flex items-center gap-1" data-intensidad-selector={interactivo ? "true" : undefined}>
    {ORDEN.map((nivel) => {
      const disponible = niveles.includes(nivel);
      return (
        <button
          type="button"
          disabled={!interactivo || !disponible}
          data-nivel={nivel}
          aria-pressed={disponible && nivel === activo}
          aria-label={`${ETIQUETA[nivel]}${disponible ? "" : " (no disponible en este juego)"}`}
          class:list={[
            "flex items-center justify-center w-8 h-8 rounded-lg transition-opacity",
            disponible ? COLOR_CLASE[nivel] : "text-texto-secundario opacity-35",
            interactivo && disponible ? "cursor-pointer hover:opacity-80" : "cursor-default",
            interactivo && disponible && nivel === activo ? "bg-superficie border-2 border-borde" : "",
          ]}
        >
          <Icon name="flame" size={18} />
        </button>
      );
    })}
  </div>
)}
