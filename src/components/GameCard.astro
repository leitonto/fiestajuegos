---
// src/components/GameCard.astro
// - "compacta": nombre + categoría (eyebrow) + jugadores/duración en una línea + badges abajo.
// - "fila": nombre a la izquierda, meta + llamas + badge alineados a la derecha, todo en una fila.
import type { CollectionEntry } from "astro:content";
import Icon from "./Icon.astro";
import IntensidadBadge from "./IntensidadBadge.astro";
import AlcoholBadge from "./AlcoholBadge.astro";

interface Props {
  juego: CollectionEntry<"juegos">;
  categoriaNombre?: string;
  densidad?: "compacta" | "fila";
}

const { juego, categoriaNombre, densidad = "compacta" } = Astro.props;
const d = juego.data;
---

{densidad === "fila" ? (
  <a
    href={`/juegos/${juego.id}`}
    class="flex items-center justify-between gap-4 border-2 border-borde rounded-xl px-4 py-3 bg-superficie hover:bg-fondo transition-colors"
  >
    <span class="font-display font-bold">{d.nombre}</span>
    <span class="flex items-center gap-4 flex-shrink-0">
      <span class="hidden sm:inline-flex items-center gap-1 text-sm text-texto-secundario">
        <Icon name="users" size={15} />
        {d.jugadores.minimo}–{d.jugadores.maximo}
      </span>
      <span class="hidden sm:inline-flex items-center gap-1 text-sm text-texto-secundario">
        <Icon name="clock" size={15} />
        {d.duracionEstimada}
      </span>
      <IntensidadBadge niveles={d.intensidad} escala={d.intensidadEscala} />
      <AlcoholBadge alcohol={d.alcohol} />
    </span>
  </a>
) : (
  <a
    href={`/juegos/${juego.id}`}
    class="block border-2 border-borde rounded-xl p-4 bg-superficie hover:-translate-y-0.5 hover:shadow-md transition-all"
  >
    {categoriaNombre && (
      <p class="text-xs uppercase tracking-wide text-categoria font-bold mb-1">{categoriaNombre}</p>
    )}
    <h3 class="font-display font-bold text-lg">{d.nombre}</h3>
    <p class="text-sm text-texto-secundario mt-1 flex items-center gap-3 flex-wrap">
      <span class="inline-flex items-center gap-1">
        <Icon name="users" size={15} />
        {d.jugadores.minimo}–{d.jugadores.maximo}
      </span>
      <span class="inline-flex items-center gap-1">
        <Icon name="clock" size={15} />
        {d.duracionEstimada}
      </span>
    </p>
    <div class="mt-3 flex items-center justify-between">
      <IntensidadBadge niveles={d.intensidad} escala={d.intensidadEscala} />
      <AlcoholBadge alcohol={d.alcohol} />
    </div>
  </a>
)}
