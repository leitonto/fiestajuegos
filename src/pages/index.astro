---
// src/pages/index.astro
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import GameCard from "../components/GameCard.astro";
import { getCollection } from "astro:content";
import { getStats } from "../lib/stats";

const juegos = await getCollection("juegos");
const ocasiones = await getCollection("ocasiones");
const categorias = await getCollection("categorias");
const stats = await getStats();
const nombrePorCategoria = Object.fromEntries(categorias.map((c) => [c.id, c.data.nombre]));

// Datos mínimos para filtrar en el cliente sin pedir nada al servidor (sitio 100% estático)
const juegosParaFiltro = juegos.map((j) => ({
  slug: j.id,
  minimo: j.data.jugadores.minimo,
  maximo: j.data.jugadores.maximo,
  alcohol: j.data.alcohol,
  intensidad: j.data.intensidad,
  escala: j.data.intensidadEscala,
}));
---

<Layout
  title="FiestaJuegos — Juegos de fiesta para jugar en grupo, con o sin alcohol"
  description="34 juegos de fiesta gratis para jugar en español: con amigos, en pareja o en familia. Elegí cuántos son, con o sin alcohol, y arrancá en segundos."
>
  <div class="max-w-3xl mx-auto px-4 py-10">
    <!-- Hero / Onboarding -->
    <div class="text-center">
      <h1 class="font-display font-extrabold text-3xl sm:text-4xl">
        El juego para esta noche, elegido en 10 segundos
      </h1>
      <p class="mt-3 text-texto-secundario text-lg">
        Sin descargas, sin registro. Elige y arranca.
      </p>
    </div>

    <div id="onboarding" class="mt-8 border-2 border-borde rounded-xl bg-superficie p-5 sm:p-6">
      <!-- Cuántos son -->
      <div class="flex items-center justify-between">
        <span class="font-bold">Cuántos son</span>
        <div class="flex items-center gap-3">
          <button
            type="button"
            id="jugadores-menos"
            aria-label="Menos jugadores"
            class="w-9 h-9 rounded-lg border-2 border-borde hover:bg-fondo font-bold text-lg leading-none"
          >
            −
          </button>
          <span id="jugadores-valor" class="w-8 text-center font-bold text-lg">6</span>
          <button
            type="button"
            id="jugadores-mas"
            aria-label="Más jugadores"
            class="w-9 h-9 rounded-lg border-2 border-borde hover:bg-fondo font-bold text-lg leading-none"
          >
            +
          </button>
        </div>
      </div>

      <!-- Con o sin alcohol -->
      <div class="flex items-center justify-between mt-5">
        <span class="font-bold">Con o sin alcohol</span>
        <div role="group" aria-label="Con o sin alcohol" class="inline-flex rounded-lg border-2 border-borde overflow-hidden">
          <button type="button" data-alcohol-valor="con" aria-pressed="true" class="px-3 py-1.5 text-sm font-medium">
            Con
          </button>
          <button type="button" data-alcohol-valor="sin" aria-pressed="false" class="px-3 py-1.5 text-sm font-medium border-l-2 border-borde">
            Sin
          </button>
        </div>
      </div>

      <!-- Intensidad -->
      <div class="flex items-center justify-between mt-5">
        <span class="font-bold">Intensidad</span>
        <div role="group" aria-label="Intensidad" class="inline-flex rounded-lg border-2 border-borde overflow-hidden">
          <button type="button" data-intensidad-valor="suave" aria-pressed="false" class="px-3 py-1.5 text-sm font-medium">
            Suave
          </button>
          <button type="button" data-intensidad-valor="normal" aria-pressed="true" class="px-3 py-1.5 text-sm font-medium border-l-2 border-borde">
            Normal
          </button>
          <button type="button" data-intensidad-valor="picante" aria-pressed="false" class="px-3 py-1.5 text-sm font-medium border-l-2 border-borde">
            Picante
          </button>
        </div>
      </div>

      <!-- Modo de dispositivo -->
      <div class="flex items-center justify-between mt-5">
        <span class="font-bold">Cómo juegan</span>
        <div class="inline-flex rounded-lg border-2 border-borde overflow-hidden">
          <span class="px-3 py-1.5 text-sm font-medium bg-primario text-white inline-flex items-center gap-1.5">
            <Icon name="device-mobile" size={15} />
            Un solo teléfono
          </span>
          <span class="px-3 py-1.5 text-sm text-texto-secundario border-l-2 border-borde opacity-60">
            Sala con código — Próximamente
          </span>
        </div>
      </div>

      <!-- CTA -->
      <button
        id="empezar-ya"
        type="button"
        class="mt-7 w-full bg-primario text-white font-display font-extrabold text-xl py-4 rounded-xl hover:opacity-90 transition-opacity"
      >
        Empezar ya
      </button>

      <p class="mt-4 text-center text-sm flex items-center justify-center gap-4">
        <button type="button" id="ver-opciones" class="underline text-texto-secundario hover:text-texto">
          Ver 3-5 opciones
        </button>
        <a href="/juegos" class="underline text-texto-secundario hover:text-texto">Ver el catálogo completo</a>
      </p>
    </div>

    <!-- Menú curado (Ideas §5.1, fricción media) — oculto hasta que se pide -->
    <div id="menu-curado" class="hidden mt-6 border-2 border-borde rounded-xl bg-superficie p-5 sm:p-6">
      <div class="flex items-center justify-between mb-4">
        <h2 class="font-display font-bold text-lg">Elegí uno</h2>
        <button type="button" id="menu-curado-cerrar" aria-label="Cerrar" class="flex-shrink-0">
          <Icon name="x" size={20} />
        </button>
      </div>
      <div id="menu-curado-opciones" class="grid gap-3"></div>
      <button
        type="button"
        id="menu-curado-rerollear"
        class="mt-4 w-full border-2 border-borde font-bold py-2.5 rounded-lg hover:bg-fondo transition-colors"
      >
        Ninguno me convence
      </button>
      <p id="menu-curado-aviso" class="hidden mt-3 text-sm text-texto-secundario text-center">
        Ya probaste varias — ¿por qué no arrancas con alguna de estas? También puedes ver el catálogo completo.
      </p>
    </div>

    <!-- Las 34 fichas ya renderizadas, ocultas: el menú curado elige entre estas en vez
         de armar HTML a mano por JS. Reusa el mismo componente/estilo que el resto del sitio. -->
    <div id="banco-cards" class="hidden" data-pagefind-ignore>
      {juegos.map((j) => (
        <div
          data-slug={j.id}
          data-minimo={j.data.jugadores.minimo}
          data-maximo={j.data.jugadores.maximo}
          data-alcohol={j.data.alcohol}
          data-intensidad={j.data.intensidad.join(",")}
          data-escala={j.data.intensidadEscala ? "1" : "0"}
        >
          <GameCard juego={j} categoriaNombre={nombrePorCategoria[j.data.categoria]} />
        </div>
      ))}
    </div>

    <!-- Stats-bar (después del CTA, no antes — Diseño Visual §8.1) -->
    <p class="mt-8 text-center text-sm text-texto-secundario">
      {stats.juegos} juegos · {stats.retos} retos{stats.articulos ? ` · ${stats.articulos} artículos` : ""}
    </p>

    <!-- Pilares de ocasión -->
    <section class="mt-14">
      <h2 class="font-display font-bold text-2xl mb-5">¿Para qué momento?</h2>
      <div class="grid grid-cols-1 min-[420px]:grid-cols-2 sm:grid-cols-3 gap-3">
        {ocasiones.map((o) => (
          <a
            href={`/ocasion/${o.id}`}
            class="border-2 border-borde rounded-xl p-4 text-center bg-superficie hover:-translate-y-0.5 hover:shadow-md transition-all"
          >
            <span class="font-display font-bold break-words">{o.data.nombre}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Categorías (navegación secundaria) -->
    <p class="mt-10 text-center text-sm text-texto-secundario">
      {categorias.map((c, i) => (
        <>
          <a href={`/categoria/${c.id}`} class="underline hover:text-texto">{c.data.nombre}</a>
          {i < categorias.length - 1 ? " · " : ""}
        </>
      ))}
    </p>
  </div>
</Layout>

<script define:vars={{ juegosParaFiltro }}>
  const JUEGOS = juegosParaFiltro;
  let jugadores = 6;
  let alcohol = "con";
  let intensidad = "normal";

  const valorEl = document.getElementById("jugadores-valor");
  document.getElementById("jugadores-menos").addEventListener("click", () => {
    jugadores = Math.max(2, jugadores - 1);
    valorEl.textContent = String(jugadores);
  });
  document.getElementById("jugadores-mas").addEventListener("click", () => {
    jugadores = Math.min(30, jugadores + 1);
    valorEl.textContent = String(jugadores);
  });

  function wireGrupo(selector, onSet) {
    const botones = document.querySelectorAll(selector);
    botones.forEach((btn) => {
      btn.addEventListener("click", () => {
        botones.forEach((b) => b.setAttribute("aria-pressed", "false"));
        btn.setAttribute("aria-pressed", "true");
        onSet(btn);
        botones.forEach((b) => {
          const on = b.getAttribute("aria-pressed") === "true";
          b.classList.toggle("bg-primario", on);
          b.classList.toggle("text-white", on);
        });
      });
    });
    // estado inicial
    botones.forEach((b) => {
      const on = b.getAttribute("aria-pressed") === "true";
      b.classList.toggle("bg-primario", on);
      b.classList.toggle("text-white", on);
    });
  }

  wireGrupo("[data-alcohol-valor]", (btn) => (alcohol = btn.dataset.alcoholValor));
  wireGrupo("[data-intensidad-valor]", (btn) => (intensidad = btn.dataset.intensidadValor));

  document.getElementById("empezar-ya").addEventListener("click", () => {
    const pool = candidatosFiltrados();
    const elegido = pool[Math.floor(Math.random() * pool.length)];
    agregarHistorial(elegido.slug);
    window.location.href = "/juegos/" + elegido.slug;
  });

  // ---------- Menú curado (Ideas §5.1, fricción media) ----------
  const HISTORIAL_CLAVE = "fiestajuegos_historial";
  const HISTORIAL_MAX = 15;

  function leerHistorial() {
    try {
      return JSON.parse(localStorage.getItem(HISTORIAL_CLAVE) || "[]");
    } catch {
      return [];
    }
  }

  function agregarHistorial(slug) {
    const h = leerHistorial();
    const sinDuplicar = h.filter((s) => s !== slug);
    sinDuplicar.push(slug);
    while (sinDuplicar.length > HISTORIAL_MAX) sinDuplicar.shift();
    localStorage.setItem(HISTORIAL_CLAVE, JSON.stringify(sinDuplicar));
  }

  function candidatosFiltrados() {
    const base = JUEGOS.filter((j) => {
      const cabenJugadores = jugadores >= j.minimo && jugadores <= j.maximo;
      const cumpleAlcohol = j.alcohol === "adaptable" || j.alcohol === alcohol;
      const cumpleIntensidad = j.escala || j.intensidad.includes(intensidad);
      return cabenJugadores && cumpleAlcohol && cumpleIntensidad;
    });
    // 3 niveles de fallback: matchea y no visto -> matchea aunque ya visto -> pool completo
    const historial = leerHistorial();
    const sinRepetir = base.filter((j) => !historial.includes(j.slug));
    if (sinRepetir.length > 0) return sinRepetir;
    if (base.length > 0) return base;
    return JUEGOS;
  }

  function elegirAlAzar(pool, cantidad) {
    const copia = [...pool];
    const resultado = [];
    while (resultado.length < cantidad && copia.length > 0) {
      const i = Math.floor(Math.random() * copia.length);
      resultado.push(copia.splice(i, 1)[0]);
    }
    return resultado;
  }

  function renderizarOpciones(elegidos) {
    const contenedor = document.getElementById("menu-curado-opciones");
    contenedor.innerHTML = "";
    elegidos.forEach((j) => {
      const original = document.querySelector('#banco-cards [data-slug="' + j.slug + '"]');
      if (original) contenedor.appendChild(original.cloneNode(true));
    });
  }

  let rerolls = 0;

  function abrirMenuCurado() {
    rerolls = 0;
    document.getElementById("menu-curado-aviso").classList.add("hidden");
    const pool = candidatosFiltrados();
    renderizarOpciones(elegirAlAzar(pool, Math.min(5, pool.length)));
    document.getElementById("menu-curado").classList.remove("hidden");
    document.getElementById("menu-curado").scrollIntoView({ behavior: "smooth", block: "nearest" });
  }

  document.getElementById("ver-opciones").addEventListener("click", abrirMenuCurado);

  document.getElementById("menu-curado-cerrar").addEventListener("click", () => {
    document.getElementById("menu-curado").classList.add("hidden");
  });

  document.getElementById("menu-curado-rerollear").addEventListener("click", () => {
    rerolls++;
    const pool = candidatosFiltrados();
    renderizarOpciones(elegirAlAzar(pool, Math.min(5, pool.length)));
    if (rerolls >= 3) {
      document.getElementById("menu-curado-aviso").classList.remove("hidden");
    }
  });

  document.getElementById("menu-curado-opciones").addEventListener("click", (e) => {
    const tarjeta = e.target.closest("[data-slug]");
    if (tarjeta) agregarHistorial(tarjeta.dataset.slug);
  });
</script>
