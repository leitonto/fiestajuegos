---
// src/pages/juegos/[slug].astro
import { getCollection, getEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import IntensidadBadge from "../../components/IntensidadBadge.astro";
import AlcoholBadge from "../../components/AlcoholBadge.astro";

export async function getStaticPaths() {
  const juegos = await getCollection("juegos");
  return juegos.map((juego) => ({
    params: { slug: juego.id },
    props: { juego },
  }));
}

const { juego } = Astro.props;
const d = juego.data;

const categoria = await getEntry("categorias", d.categoria);
const todasOcasiones = await getCollection("ocasiones");
const ocasionesDelJuego = todasOcasiones.filter((o) => d.ocasiones.includes(o.id));

// FAQPage JSON-LD — Marketing §5.1: ya no da rich result visible, pero sigue
// siendo señal útil para que sistemas de IA entiendan la página.
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: d.faq.map((f) => ({
    "@type": "Question",
    name: f.pregunta,
    acceptedAnswer: { "@type": "Answer", text: f.respuesta },
  })),
};
---

<Layout title={d.seo.titulo} description={d.seo.metaDescripcion}>
  <div class="max-w-3xl mx-auto px-4 py-8">
    <!-- 1. Breadcrumb -->
    <nav class="text-sm text-texto-secundario mb-6" aria-label="Ruta de navegación">
      <a href="/" class="hover:text-texto hover:underline">Inicio</a>
      <span class="mx-1.5">›</span>
      <a href={`/categoria/${d.categoria}`} class="hover:text-texto hover:underline">
        {categoria?.data.nombre ?? d.categoria}
      </a>
      <span class="mx-1.5">›</span>
      <span class="text-texto">{d.nombre}</span>
    </nav>

    <!-- 2. H1 + gancho -->
    <h1 class="font-display font-extrabold text-3xl sm:text-4xl">{d.nombre}</h1>
    {d.seo.gancho && <p class="mt-2 text-lg text-texto-secundario">{d.seo.gancho}</p>}

    <!-- 3. Caja de datos rápidos -->
    <div class="mt-6 border-2 border-borde rounded-xl bg-superficie p-4 flex flex-wrap items-center gap-x-6 gap-y-3">
      <span class="inline-flex items-center gap-1.5">
        <Icon name="users" size={18} />
        {d.jugadores.minimo}–{d.jugadores.maximo} jugadores
      </span>
      <span class="inline-flex items-center gap-1.5">
        <Icon name="clock" size={18} />
        {d.duracionEstimada}
      </span>
      <AlcoholBadge alcohol={d.alcohol} />
      <IntensidadBadge
        niveles={d.intensidad}
        escala={d.intensidadEscala}
        interactivo={!d.intensidadEscala}
        activo="normal"
      />
    </div>

    <!-- 4. H2 = pregunta AI Overview + respuesta directa -->
    <section class="mt-10">
      <h2 class="font-display font-bold text-2xl">{d.seo.preguntaAIOverview}</h2>
      {d.seo.respuestaDirecta && <p class="mt-3 text-lg leading-relaxed">{d.seo.respuestaDirecta}</p>}
    </section>

    <!-- 5. Reglas paso a paso -->
    <section class="mt-10">
      <h2 class="font-display font-bold text-2xl mb-4">Cómo se juega</h2>
      <ol class="space-y-3 list-none">
        {d.reglas.map((paso, i) => (
          <li class="flex gap-3">
            <span class="flex-shrink-0 w-7 h-7 rounded-full border-2 border-borde flex items-center justify-center text-sm font-bold">
              {i + 1}
            </span>
            <span class="pt-0.5">{paso}</span>
          </li>
        ))}
      </ol>
    </section>

    <!-- 6. Variantes -->
    {d.variantes.length > 0 && (
      <section class="mt-10">
        <h2 class="font-display font-bold text-2xl mb-4">Variantes</h2>
        <ul class="space-y-3">
          {d.variantes.map((v) => (
            <li class="border-2 border-borde rounded-xl p-4">
              {v.nombre && <p class="font-bold mb-1">{v.nombre}</p>}
              <p class="text-texto-secundario">{v.descripcion}</p>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- 7. FAQ en acordeón -->
    {d.faq.length > 0 && (
      <section class="mt-10">
        <h2 class="font-display font-bold text-2xl mb-4">Preguntas frecuentes</h2>
        <div class="space-y-2">
          {d.faq.map((f) => (
            <details class="group border-2 border-borde rounded-xl p-4">
              <summary class="flex items-center justify-between cursor-pointer font-bold list-none">
                {f.pregunta}
                <Icon name="chevron-down" size={20} class="transition-transform group-open:rotate-180 flex-shrink-0 ml-2" />
              </summary>
              <p class="mt-3 text-texto-secundario">{f.respuesta}</p>
            </details>
          ))}
        </div>
      </section>
    )}

    <!-- Cross-link a ocasiones (Marketing §4.5) -->
    {ocasionesDelJuego.length > 0 && (
      <section class="mt-10">
        <p class="text-sm text-texto-secundario mb-2">Bueno también para:</p>
        <div class="flex flex-wrap gap-2">
          {ocasionesDelJuego.map((o) => (
            <a
              href={`/ocasion/${o.id}`}
              class="text-sm px-3 py-1.5 rounded-lg border-2 border-borde text-categoria hover:bg-superficie"
            >
              {o.data.nombre}
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- 8. Disclaimer -->
    {d.disclaimer && (
      <div class="mt-10 border-2 border-borde rounded-xl p-4 text-sm text-texto-secundario bg-superficie">
        Contenido para mayores de 18 años en las secciones que incluyen alcohol. Bebe con
        responsabilidad — este sitio no vende alcohol ni promueve su consumo excesivo.
      </div>
    )}
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Layout>

<script>
  // Selector de intensidad interactivo: actualiza ?intensidad= en la URL sin recargar
  // (deep-link previsto en Ideas §5.4 / Marketing §4.4). No filtra contenido todavía —
  // eso depende de la vista de "jugar", que es un paso aparte.
  const selector = document.querySelector("[data-intensidad-selector]");
  selector?.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest("button[data-nivel]") as HTMLButtonElement | null;
    if (!btn || btn.disabled) return;
    const nivel = btn.dataset.nivel!;
    const url = new URL(window.location.href);
    url.searchParams.set("intensidad", nivel);
    history.replaceState(null, "", url);
    selector.querySelectorAll("button[data-nivel]").forEach((b) => {
      b.setAttribute("aria-pressed", String(b === btn));
      b.classList.toggle("bg-superficie", b === btn);
      b.classList.toggle("border-2", b === btn);
      b.classList.toggle("border-borde", b === btn);
    });
  });
</script>
