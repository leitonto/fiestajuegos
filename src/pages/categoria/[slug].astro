---
// src/pages/categoria/[slug].astro
import { getCollection, getEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import GameCard from "../../components/GameCard.astro";

export async function getStaticPaths() {
  const categorias = await getCollection("categorias");
  return categorias.map((c) => ({
    params: { slug: c.id },
    props: { categoria: c },
  }));
}

const { categoria } = Astro.props;
const d = categoria.data;

const todosJuegos = await getCollection("juegos");
const juegosDeEstaCategoria = todosJuegos
  .filter((j) => j.data.categoria === categoria.id)
  .sort((a, b) => a.data.nombre.localeCompare(b.data.nombre));

const OCASION_RELACIONADA: Record<string, string> = { parejas: "cita" };
const ocasionRelacionada = OCASION_RELACIONADA[categoria.id]
  ? await getEntry("ocasiones", OCASION_RELACIONADA[categoria.id])
  : null;
---

<Layout
  title={`${d.nombre} — juegos de fiesta | FiestaJuegos`}
  description={`${juegosDeEstaCategoria.length} juegos de la categoría ${d.nombre}: ${d.descripcion}`}
>
  <div class="max-w-3xl mx-auto px-4 py-10">
    <nav class="text-sm text-texto-secundario mb-6" aria-label="Ruta de navegación">
      <a href="/" class="hover:text-texto hover:underline">Inicio</a>
      <span class="mx-1.5">›</span>
      <span class="text-texto">{d.nombre}</span>
    </nav>

    <h1 class="font-display font-extrabold text-3xl sm:text-4xl">{d.nombre}</h1>
    <p class="mt-3 text-lg text-texto-secundario">{d.descripcion}</p>

    <p class="mt-6 text-sm font-bold">{juegosDeEstaCategoria.length} juegos en esta categoría</p>

    <div class="mt-4 space-y-2">
      {juegosDeEstaCategoria.map((j) => (
        <GameCard juego={j} densidad="fila" />
      ))}
    </div>

    {ocasionRelacionada && (
      <p class="mt-8 text-center">
        <a href={`/ocasion/${ocasionRelacionada.id}`} class="underline text-texto-secundario hover:text-texto">
          Ver también: juegos para {ocasionRelacionada.data.nombre.toLowerCase()}
        </a>
      </p>
    )}
  </div>
</Layout>